{
  "name": "actual-css",
  "version": "0.3.1",
  "description": "Plain CSS component framework with semantic classes, universal variants, small tokens, theme hooks, and progressive enhancements.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "author": "Thomas <thomas@lekoala.be>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lekoala/actual-css.git"
  },
  "homepage": "https://github.com/lekoala/actual-css",
  "bugs": {
    "url": "https://github.com/lekoala/actual-css/issues"
  },
  "keywords": [
    "css",
    "css-framework",
    "component-library",
    "semantic",
    "accessibility",
    "dark-mode",
    "themable",
    "no-build",
    "progressive-enhancement"
  ],
  "exports": {
    ".": "./dist/actual.min.css",
    "./full": "./dist/actual.full.min.css",
    "./css": "./src/css/actual.css",
    "./css/components": "./src/css/components/index.css",
    "./css/components/*": "./src/css/components/*.css",
    "./css/effects": "./src/css/effects/index.css",
    "./css/effects/*": "./src/css/effects/*.css",
    "./css/forms": "./src/css/forms/base.css",
    "./css/forms/all": "./src/css/forms/index.css",
    "./css/forms/*": "./src/css/forms/*.css",
    "./css/full": "./src/css/actual.full.css",
    "./css/layer": "./src/css/actual.layer.css",
    "./css/layout": "./src/css/layout/index.css",
    "./css/layout/*": "./src/css/layout/*.css",
    "./css/themes": null,
    "./css/themes/*": null,
    "./css/typography": "./src/css/typography/index.css",
    "./css/typography/*": "./src/css/typography/*.css",
    "./css/utilities": "./src/css/utilities/index.css",
    "./css/utilities/*": "./src/css/utilities/*.css",
    "./js": "./src/js/index.js",
    "./js/full": "./src/js/full.js",
    "./js/command": "./src/js/command.js",
    "./js/context-menu": "./src/js/context-menu.js",
    "./js/dialog": "./src/js/dialog.js",
    "./js/dismiss": "./src/js/dismiss.js",
    "./js/escape": "./src/js/escape.js",
    "./js/enhance": "./src/js/enhance.js",
    "./js/enhancement-loader": "./src/js/enhancement-loader.js",
    "./js/parse-config": "./src/js/parse-config.js",
    "./js/events": "./src/js/events.js",
    "./js/filter": "./src/js/filter.js",
    "./js/floating": "./src/js/floating.js",
    "./js/flyout": "./src/js/flyout.js",
    "./js/focus": "./src/js/focus.js",
    "./js/focus-group": "./src/js/focus-group.js",
    "./js/input": "./src/js/input.js",
    "./js/keys": "./src/js/keys.js",
    "./js/mask": "./src/js/mask.js",
    "./js/menu": "./src/js/menu.js",
    "./js/password": "./src/js/password.js",
    "./js/scrollspy": "./src/js/scrollspy.js",
    "./js/selectors": "./src/js/selectors.js",
    "./js/tab": "./src/js/tab.js",
    "./js/tooltip": "./src/js/tooltip.js",
    "./js/validation": "./src/js/validation.js",
    "./js/status": "./src/js/status.js",
    "./js/surface": "./src/js/surface.js",
    "./reserved-classes.json": "./scripts/reserved-classes.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/actual.js",
  "style": "./dist/actual.min.css",
  "unpkg": "./dist/actual.min.css",
  "jsdelivr": "./dist/actual.min.css",
  "sideEffects": true,
  "files": [
    "dist",
    "src/css/*.css",
    "src/css/core",
    "src/css/layout",
    "src/css/typography",
    "src/css/forms",
    "src/css/components",
    "src/css/effects",
    "src/css/utilities",
    "src/css/themes",
    "src/js",
    "scripts/reserved-classes.json",
    "docs",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:docs": "bun scripts/build-docs.js",
    "watch:docs": "bun scripts/build-docs.js --watch",
    "check:docs": "bun scripts/check-docs.js",
    "check:compat": "bun scripts/check-compat.js",
    "check:css-api": "bun scripts/check-css-api.js",
    "check:architecture": "bun scripts/check-css-architecture.js",
    "build:dist": "bun scripts/build-dist.js",
    "build:js": "bun scripts/build-js.js",
    "build:size": "bun scripts/build-size.js",
    "check:enhance": "bun run scripts/check-enhance.js",
    "check:reserved": "bun scripts/check-reserved.js",
    "check:links": "bun scripts/check-doc-links.js",
    "check:templates": "bun scripts/check-templates.js",
    "shot:forced": "bun scripts/forced-colors-shot.js",
    "shot:multi": "bun scripts/multi-shot.js",
    "shot:page": "bun scripts/page-shot.js",
    "probe": "bun scripts/probe.js",
    "check:sync": "bun scripts/check-sync.js",
    "test": "bun test",
    "test:changed": "bun test --changed=master",
    "build:all": "bun run build:dist && bun run build:js && bun run build:docs && bun run check:docs && bun run check:compat && bun run check:css-api && bun run check:architecture && bun run check:enhance && bun run check:reserved && bun run check:sync && bun run check:links && bun run check:templates && bun run test && bun run build:size",
    "prepublishOnly": "bun run build:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "happy-dom": "^20.11"
  }
}
