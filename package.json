{
  "name": "actual-css",
  "version": "0.19.5",
  "description": "Plain CSS component framework with semantic classes, universal variants, small tokens, theme hooks, and progressive enhancements.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "license": "MIT",
  "author": "Thomas <thomas@lekoala.be>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lekoala/actual-css.git"
  },
  "homepage": "https://lekoala.github.io/actual-css/site/",
  "bugs": {
    "url": "https://github.com/lekoala/actual-css/issues"
  },
  "keywords": [
    "css",
    "css-framework",
    "component-library",
    "semantic",
    "accessibility",
    "dark-mode",
    "themable",
    "no-build",
    "progressive-enhancement"
  ],
  "exports": {
    ".": "./dist/actual.full.min.css",
    "./full": "./dist/actual.full.min.css",
    "./css": "./src/css/actual.css",
    "./css/components": "./src/css/components/index.css",
    "./css/components/*": "./src/css/components/*.css",
    "./css/effects": "./src/css/effects/index.css",
    "./css/effects/*": "./src/css/effects/*.css",
    "./css/forms": "./src/css/forms/base.css",
    "./css/forms/all": "./src/css/forms/index.css",
    "./css/forms/*": "./src/css/forms/*.css",
    "./css/full": "./src/css/actual.full.css",
    "./css/layer": "./src/css/actual.layer.css",
    "./css/layout": "./src/css/layout/index.css",
    "./css/layout/*": "./src/css/layout/*.css",
    "./css/themes": null,
    "./css/themes/*": null,
    "./css/typography": "./src/css/typography/index.css",
    "./css/typography/*": "./src/css/typography/*.css",
    "./css/utilities": "./src/css/utilities/index.css",
    "./css/utilities/*": "./src/css/utilities/*.css",
    "./js": { "types": "./dist/types/index.d.ts", "default": "./src/js/index.js" },
    "./js/full": { "types": "./dist/types/full.d.ts", "default": "./src/js/full.js" },
    "./js/command": { "types": "./dist/types/command.d.ts", "default": "./src/js/command.js" },
    "./js/context-menu": { "types": "./dist/types/context-menu.d.ts", "default": "./src/js/context-menu.js" },
    "./js/dialog": { "types": "./dist/types/dialog.d.ts", "default": "./src/js/dialog.js" },
    "./js/dismiss": { "types": "./dist/types/dismiss.d.ts", "default": "./src/js/dismiss.js" },
    "./js/escape": { "types": "./dist/types/escape.d.ts", "default": "./src/js/escape.js" },
    "./js/enhance": { "types": "./dist/types/enhance.d.ts", "default": "./src/js/enhance.js" },
    "./js/enhancement-loader": { "types": "./dist/types/enhancement-loader.d.ts", "default": "./src/js/enhancement-loader.js" },
    "./js/parse-config": { "types": "./dist/types/parse-config.d.ts", "default": "./src/js/parse-config.js" },
    "./js/events": { "types": "./dist/types/events.d.ts", "default": "./src/js/events.js" },
    "./js/filter": { "types": "./dist/types/filter.d.ts", "default": "./src/js/filter.js" },
    "./js/flyout": { "types": "./dist/types/flyout.d.ts", "default": "./src/js/flyout.js" },
    "./js/focus": { "types": "./dist/types/focus.d.ts", "default": "./src/js/focus.js" },
    "./js/focus-group": { "types": "./dist/types/focus-group.d.ts", "default": "./src/js/focus-group.js" },
    "./js/input": { "types": "./dist/types/input.d.ts", "default": "./src/js/input.js" },
    "./js/in-view": { "types": "./dist/types/in-view.d.ts", "default": "./src/js/in-view.js" },
    "./js/keys": { "types": "./dist/types/keys.d.ts", "default": "./src/js/keys.js" },
    "./js/mask": { "types": "./dist/types/mask.d.ts", "default": "./src/js/mask.js" },
    "./js/menu": { "types": "./dist/types/menu.d.ts", "default": "./src/js/menu.js" },
    "./js/password": { "types": "./dist/types/password.d.ts", "default": "./src/js/password.js" },
    "./js/range": { "types": "./dist/types/range.d.ts", "default": "./src/js/range.js" },
    "./js/scrollspy": { "types": "./dist/types/scrollspy.d.ts", "default": "./src/js/scrollspy.js" },
    "./js/selectors": { "types": "./dist/types/selectors.d.ts", "default": "./src/js/selectors.js" },
    "./js/tab": { "types": "./dist/types/tab.d.ts", "default": "./src/js/tab.js" },
    "./js/tooltip": { "types": "./dist/types/tooltip.d.ts", "default": "./src/js/tooltip.js" },
    "./js/validation": { "types": "./dist/types/validation.d.ts", "default": "./src/js/validation.js" },
    "./js/dirty": { "types": "./dist/types/dirty.d.ts", "default": "./src/js/dirty.js" },
    "./js/ajax": { "types": "./dist/types/ajax.d.ts", "default": "./src/js/ajax.js" },
    "./js/status": { "types": "./dist/types/status.d.ts", "default": "./src/js/status.js" },
    "./js/surface": { "types": "./dist/types/surface.d.ts", "default": "./src/js/surface.js" },
    "./reserved-classes.json": "./reserved-classes.json",
    "./components.json": "./components.json",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "actual-css": "./src/cli/actual-css.js"
  },
  "style": "./dist/actual.full.min.css",
  "unpkg": "./dist/actual.full.min.css",
  "jsdelivr": "./dist/actual.full.min.css",
  "sideEffects": true,
  "files": [
    "dist",
    "src/css/*.css",
    "src/css/core",
    "src/css/layout",
    "src/css/typography",
    "src/css/forms",
    "src/css/components",
    "src/css/effects",
    "src/css/utilities",
    "src/cli",
    "src/js",
    "src/tooling",
    "reserved-classes.json",
    "components.json",
    "tokens.json",
    "docs/pages",
    "docs/brand",
    "skills",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "scripts": {
    "hooks:install": "bun scripts/install-hooks.js",
    "lint": "biome check --reporter concise",
    "lint:fix": "biome check --write",
    "build:docs": "bun run build:themes && bun scripts/build-docs.js",
    "watch:docs": "bun run build:themes && bun scripts/build-docs.js --watch",
    "check:docs": "bun scripts/check-docs.js",
    "format:docs": "bun scripts/format-doc-tables.js",
    "check:doc-classes": "bun scripts/check-doc-classes.js",
    "check:compat": "bun scripts/check-compat.js",
    "check:css-api": "bun scripts/check-css-api.js",
    "check:color-space": "bun scripts/check-color-space.js",
    "report:theme-contrast": "bun scripts/report-theme-contrast.js",
    "report:neutral-ramp": "bun scripts/report-neutral-ramp.js",
    "report:dead-css": "bun scripts/report-dead-css.js",
    "report:composition": "bun scripts/report-composition.js",
    "report:overflow": "bun scripts/report-overflow.js",
    "report:paint": "bun scripts/report-paint.js",
    "check:architecture": "bun scripts/check-css-architecture.js",
    "build:dist": "bun scripts/build-dist.js",
    "build:js": "bun scripts/build-js.js",
    "build:types": "tsc -p tsconfig.types.json",
    "build:themes": "bun scripts/build-themes.js",
    "build:size": "bun scripts/build-size.js",
    "build:pages": "bun scripts/pages.js",
    "export:design": "bun scripts/export-design.js",
    "check:enhance": "bun run scripts/check-enhance.js",
    "generate:reserved": "bun scripts/generate-reserved-classes.js",
    "check:reserved": "bun scripts/check-reserved.js",
    "generate:catalog": "bun scripts/build-catalog.js",
    "check:catalog": "bun scripts/check-catalog.js",
    "check:links": "bun scripts/check-doc-links.js",
    "check:templates": "bun scripts/check-templates.js",
    "shot:crop": "bun scripts/shot-crop.js",
    "shot:forced": "bun scripts/forced-colors-shot.js",
    "shot:multi": "bun scripts/multi-shot.js",
    "shot:page": "bun scripts/page-shot.js",
    "shot:states": "bun scripts/shot-states.js",
    "probe": "bun scripts/probe.js",
    "serve": "bun scripts/serve.js",
    "play:ajax": "bun --watch scripts/playground/ajax.js",
    "check:sync": "bun scripts/check-sync.js",
    "release": "bun scripts/release.js",
    "release:notes": "bun scripts/release-notes.js",
    "test": "bun test",
    "test:changed": "bun test --changed=master",
    "build:all": "bun run lint && bun run build:dist && bun run build:js && bun run build:types && bun run build:size && bun run format:docs && bun run build:docs && bun run check:docs && bun run check:doc-classes && bun run check:compat && bun run check:css-api && bun run check:color-space && bun run check:architecture && bun run check:enhance && bun run generate:reserved && bun run check:reserved && bun run generate:catalog && bun run check:catalog && bun run check:sync && bun run check:links && bun run check:templates && bun run test",
    "prepublishOnly": "bun run build:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@lekoala/floating": "^0.3.1"
  }
}
