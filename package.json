{
  "name": "actual-css",
  "version": "0.1.0",
  "description": "Plain CSS component framework with semantic classes, universal variants, small tokens, strong themes, and progressive enhancements.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "map": "node scripts/project-map.js",
    "check": "npm run lint",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check:css": "node scripts/check-css.js",
    "test": "npm run test:contracts",
    "test:contracts": "node --test tests/contracts/architecture.test.js tests/contracts/manifest.test.js",
    "verify": "node scripts/verify.js",
    "verify:ci": "node scripts/verify.js --ci",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.44.0"
  }
}
