{
  "name": "actual-css",
  "version": "0.1.0",
  "description": "Plain CSS component framework with semantic classes, universal variants, small tokens, theme hooks, and progressive enhancements.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "author": "Thomas <thomas@lekoala.be>",
  "repository": {
    "type": "git",
    "url": "https://onedev.kalyptus.ovh/actual-css.git"
  },
  "homepage": "https://onedev.kalyptus.ovh/actual-css",
  "bugs": {
    "url": "https://onedev.kalyptus.ovh/actual-css/issues"
  },
  "keywords": [
    "css",
    "css-framework",
    "component-library",
    "semantic",
    "accessibility",
    "dark-mode",
    "themable",
    "no-build",
    "progressive-enhancement"
  ],
  "exports": {
    ".": "./dist/actual.min.css",
    "./css": "./src/css/actual.css",
    "./css/layer": "./src/css/actual.layer.css",
    "./css/components": "./src/css/components/index.css",
    "./css/forms": "./src/css/forms/index.css",
    "./css/themes": null,
    "./css/themes/*": null,
    "./css/*": "./src/css/*.css",
    "./js": "./src/js/index.js",
    "./js/command": "./src/js/command.js",
    "./js/context-menu": "./src/js/context-menu.js",
    "./js/dialog": "./src/js/dialog.js",
    "./js/dialog-fallback": "./src/js/dialog-fallback.js",
    "./js/enhance": "./src/js/enhance.js",
    "./js/filter": "./src/js/filter.js",
    "./js/floating": "./src/js/floating.js",
    "./js/flyout": "./src/js/flyout.js",
    "./js/input": "./src/js/input.js",
    "./js/mask": "./src/js/mask.js",
    "./js/password": "./src/js/password.js",
    "./js/scrollspy": "./src/js/scrollspy.js",
    "./js/selectors": "./src/js/selectors.js",
    "./js/tab": "./src/js/tab.js",
    "./js/tooltip": "./src/js/tooltip.js",
    "./js/validation": "./src/js/validation.js",
    "./js/status": "./src/js/status.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/actual.js",
  "style": "./dist/actual.min.css",
  "unpkg": "./dist/actual.min.css",
  "jsdelivr": "./dist/actual.min.css",
  "sideEffects": true,
  "files": [
    "dist",
    "!dist/actual-themes.min.css",
    "!dist/actual-themes.min.css.map",
    "src/css",
    "!src/css/themes",
    "src/js",
    "docs",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:demo": "bun scripts/build-demo.js",
    "watch:demo": "bun scripts/build-demo.js --watch",
    "build:dist": "bun scripts/build-dist.js",
    "build:js": "bun scripts/build-js.js",
    "build:size": "bun scripts/build-size.js",
    "check:reserved": "bun scripts/check-reserved.js",
    "check:links": "bun scripts/check-doc-links.js",
    "check:templates": "bun scripts/check-templates.js",
    "shot:forced": "bun scripts/forced-colors-shot.js",
    "shot:page": "bun scripts/page-shot.js",
    "check:sync": "bun scripts/check-sync.js",
    "test": "bun test",
    "build:all": "bun run build:demo && bun run build:dist && bun run check:reserved && bun run check:sync && bun run check:links && bun run check:templates && bun run test && bun run build:js && bun run build:size",
    "prepublishOnly": "bun run build:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "happy-dom": "^20.10.6",
    "prismjs": "^1.30.0"
  }
}
